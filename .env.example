# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://connor:CAMBIAR@localhost:5432/connor
# 1 si la app corre detrás de un proxy (Nginx, Render, Railway…) para leer la IP real
TRUST_PROXY=0
SESSION_HOURS=12
# Conexión TLS a una base de datos administrada (Render, Railway, RDS, Supabase…)
DATABASE_SSL=0
DB_POOL_SIZE=10
# En producción las migraciones NO se aplican al arrancar: respaldo + npm run migrate (ver docs/OPERACION.md)
AUTO_MIGRATE=0
# Retención (días): notificaciones leídas, conversaciones del asistente interno, bitácora del bot
RETENTION_NOTIFICATIONS_DAYS=90
RETENTION_ASSISTANT_DAYS=180
RETENTION_BOT_RUNS_DAYS=365
# UPLOAD_DIR=/var/lib/connor/uploads

# WhatsApp Business Platform (Cloud API de Meta) — requiere configuración en developers.facebook.com
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# Asistente virtual de WhatsApp (Claude). Clave de console.anthropic.com
ANTHROPIC_API_KEY=

# Solo para docker-compose.yml
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
