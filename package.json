{
  "name": "connor-plataforma",
  "version": "0.9.0",
  "description": "CONNOR Constructora del Noroeste: sitio público + CRM",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "create-user": "node --env-file-if-exists=.env scripts/create-user.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  }
}
